@model IEnumerable<DigitalLibrarySystem.Models.Book>
@{
    ViewData["Title"] = "Book QR Codes";
    ViewData["Page"] = "qrcodes";
}

<div class="page-header">
    <h1>📋 Book QR Codes</h1>
    <p>Scan any QR code with your camera to check out a book</p>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
    @foreach (var book in Model)
    {
        <div class="card" style="text-align:center;padding:24px;">
            <div style="background:#fff;border-radius:12px;padding:16px;
                      display:inline-block;margin-bottom:16px;">
                <img src="/Library/GenerateQR?code=@book.QRCode"
                     style="width:140px;height:140px;display:block;" />
            </div>
            <div style="font-weight:700;font-size:15px;color:#fff;margin-bottom:4px;">
                @book.Title
            </div>
            <div style="font-size:12px;color:var(--muted);margin-bottom:8px;">
                @book.Author
            </div>
            <div style="font-size:12px;color:var(--purple3);margin-bottom:10px;font-weight:600;">
                @book.QRCode
            </div>
            <div style="margin-bottom:14px;">
                @if (book.IsAvailable)
                {
                    <span class="badge badge-returned">✓ Available</span>
                }
                else
                {
                    <span class="badge badge-issued">✗ Issued</span>
                }
            </div>
            <a href="/Library/GenerateQR?code=@book.QRCode"
               download="@(book.QRCode).jpg"
               target="_blank"
               class="btn-ghost"
               style="width:100%;font-size:12px;display:block;text-align:center;
                    text-decoration:none;padding:10px 0;border-radius:10px;">
                ⬇ Download QR
            </a>
        </div>
    }
</div>