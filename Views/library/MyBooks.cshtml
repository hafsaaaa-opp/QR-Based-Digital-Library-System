@model IEnumerable<DigitalLibrarySystem.Models.Transaction>
@{
    ViewData["Title"] = "My Books";
    ViewData["Page"] = "mybooks";
}

<div class="page-header">
    <h1>📖 My Issued Books</h1>
    <p>All your current and past borrowings</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">✅ @TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-error">⚠️ @TempData["Error"]</div>
}

@{
    var overdueBooks = Model.Where(t => t.Status == "Issued" && t.DueDate < DateTime.Now).ToList();
}

@if (overdueBooks.Any())
{
    <div style="background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.4);
                    border-radius:12px;padding:16px;margin-bottom:20px;">
        <div style="font-weight:700;color:#f87171;margin-bottom:8px;">
            ⚠️ Overdue Warning — @overdueBooks.Count book(s) past due date!
        </div>
        @foreach (var ob in overdueBooks)
        {
            int days = (DateTime.Now.Date - ob.DueDate.Date).Days;
            decimal fine = days * 10;
            <div style="font-size:13px;color:#fca5a5;margin-top:4px;">
                📕 @ob.Book.Title — @days days late — Estimated fine: Rs @fine
            </div>
        }
        <div style="font-size:12px;color:rgba(248,113,113,0.6);margin-top:8px;">
            Return immediately to avoid additional charges (Rs 10/day)
        </div>
    </div>
}

<div class="card">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:48px 0;color:var(--muted);">
            <div style="font-size:48px;margin-bottom:12px;">📚</div>
            <p>No books issued yet.</p>
            <a asp-controller="Library" asp-action="Scan" style="text-decoration:none;">
                <button class="btn-primary" style="margin-top:16px;">📷 Scan to Borrow</button>
            </a>
        </div>
    }
    else
    {
        <table class="lib-table">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Book Title</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td style="color:var(--purple3);font-size:11px;">@t.TransactionID</td>
                        <td>
                            <div style="font-weight:500;">@t.Book.Title</div>
                            <div style="font-size:11px;color:var(--muted);">@t.Book.Author</div>
                        </td>
                        <td>@t.IssueDate.ToString("dd MMM yyyy")</td>
                        <td style="color:@(t.DueDate < DateTime.Now && t.Status == "Issued" ? "var(--red)" : "inherit")">
                            @t.DueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>@(t.ReturnDate.HasValue? t.ReturnDate.Value.ToString("dd MMM yyyy") : "—")</td>
                        <td>
                            <span class="badge badge-@t.Status.ToLower()">@t.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>