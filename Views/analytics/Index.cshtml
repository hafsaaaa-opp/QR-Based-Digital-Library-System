@{
    ViewData["Title"] = "Analytics Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Analytics Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* 🔧 Compact UI Fix */
        .container-fluid {
            padding: 15px !important;
        }

        .page-title {
            font-size: 1.4rem !important;
        }

        .stat-box {
            padding: 12px !important;
        }

        .stat-number {
            font-size: 1.6rem !important;
        }

        .card-header {
            padding: 10px 15px !important;
            font-size: 0.95rem;
        }

        .card-body {
            padding: 10px !important;
        }

        table {
            font-size: 0.85rem;
        }

        td, th {
            padding: 6px 8px !important;
        }

        canvas {
            max-height: 180px !important;
        }

        .mb-4 {
            margin-bottom: 1rem !important;
        }
        body {
            background: #0d1117;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .card-header {
            background: #1f2937;
            border-radius: 12px 12px 0 0 !important;
            font-weight: 600;
            color: #58a6ff;
            border-bottom: 1px solid #30363d;
            padding: 15px 20px;
        }

        .stat-box {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
        }

        .stat-number {
            font-size: 2.2rem;
            font-weight: 700;
            color: #58a6ff;
        }

        .stat-label {
            color: #8b949e;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .page-title {
            color: #58a6ff;
            font-weight: 700;
            font-size: 1.8rem;
        }

        .back-btn {
            background: #21262d;
            border: 1px solid #30363d;
            color: #58a6ff;
        }

            .back-btn:hover {
                background: #30363d;
                color: white;
            }

        table {
            color: white !important;
        }

        .table-dark {
            background: #0d1117;
        }

        thead th {
            background: #1f2937 !important;
            color: #58a6ff !important;
            border-color: #30363d !important;
        }

        td {
            border-color: #30363d !important;
        }

        tr:hover td {
            background: #1f2937 !important;
        }

        .badge-dept {
            background: #1f6feb;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid py-4 px-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="page-title">📊 Analytics Dashboard</div>
                <small style="color:#8b949e">QR Digital Library System — Sir Syed University</small>
            </div>
            <a href="/Admin/Index" class="back-btn">← Back</a>
        </div>

        <!-- Stats Row -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="stat-box">
                    <div class="stat-number" id="statStudents">...</div>
                    <div class="stat-label">Active Students</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-box">
                    <div class="stat-number" id="statBorrows">...</div>
                    <div class="stat-label">Total Borrows</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-box">
                    <div class="stat-number" id="statFines">...</div>
                    <div class="stat-label">Total Fines (Rs.)</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-box">
                    <div class="stat-number" id="statDepts">...</div>
                    <div class="stat-label">Departments</div>
                </div>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">👥 Most Active Students</div>
                    <div class="card-body p-3">
                        <canvas id="studentsChart" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">📚 Popular Books</div>
                    <div class="card-body p-3">
                        <canvas id="booksChart" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row 2 -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">💰 Fine Trends</div>
                    <div class="card-body p-3">
                        <canvas id="finesChart" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">🏛️ Department Statistics</div>
                    <div class="card-body p-3">
                        <canvas id="deptChart" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Students Table -->
        <div class="card">
            <div class="card-header">📋 Student Activity Detail</div>
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Total Borrows</th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        <tr><td colspan="5" class="text-center py-3" style="color:#8b949e">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activity Logs -->
        <div class="card">
            <div class="card-header">🔐 Recent Activity Logs</div>
            <div class="card-body p-0">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>IP Address</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="logsTableBody">
                        <tr><td colspan="6" class="text-center py-3" style="color:#8b949e">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        const chartDefaults = {
            plugins: { legend: { labels: { color: '#8b949e' } } },
            scales: {
                x: { ticks: { color: '#8b949e' }, grid: { color: '#21262d' } },
                y: { ticks: { color: '#8b949e' }, grid: { color: '#21262d' } }
            }
        };

        // Most Active Students
        fetch('/Analytics/MostActiveStudents')
            .then(r => r.json())
            .then(data => {
                document.getElementById('statStudents').textContent = data.length;
                let total = data.reduce((s, x) => s + (parseInt(x.totalBorrows) || 0), 0);
                document.getElementById('statBorrows').textContent = total;

                new Chart(document.getElementById('studentsChart'), {
                    type: 'bar',
                    data: {
                        labels: data.map(x => x.name || x.fullName || 'Unknown'),
                        datasets: [{ label: 'Books Borrowed', data: data.map(x => x.totalBorrows), backgroundColor: '#1f6feb' }]
                    },
                    options: { ...chartDefaults, responsive: true }
                });

                let tbody = document.getElementById('studentsTableBody');
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center" style="color:#8b949e">No data yet — issue some books first</td></tr>';
                } else {
                    tbody.innerHTML = data.map((x, i) => `
                        <tr>
                            <td>${i+1}</td>
                            <td>${x.studentID}</td>
                            <td>${x.name || x.fullName}</td>
                            <td><span class="badge-dept">${x.department || 'N/A'}</span></td>
                            <td><strong style="color:#58a6ff">${x.totalBorrows}</strong></td>
                        </tr>`).join('');
                }
            }).catch(() => {
                document.getElementById('statStudents').textContent = '0';
                document.getElementById('statBorrows').textContent = '0';
            });

        // Popular Books
        fetch('/Analytics/PopularBooks')
            .then(r => r.json())
            .then(data => {
                new Chart(document.getElementById('booksChart'), {
                    type: 'bar',
                    data: {
                        labels: data.map(x => (x.title || '').substring(0, 18)),
                        datasets: [{ label: 'Times Borrowed', data: data.map(x => x.borrowCount), backgroundColor: '#238636' }]
                    },
                    options: { ...chartDefaults, indexAxis: 'y', responsive: true }
                });
            }).catch(() => {});

        // Fine Trends
        fetch('/Analytics/FineTrends')
            .then(r => r.json())
            .then(data => {
                let total = data.reduce((s, x) => s + (parseFloat(x.totalFines) || 0), 0);
                document.getElementById('statFines').textContent = total.toFixed(0);

                new Chart(document.getElementById('finesChart'), {
                    type: 'line',
                    data: {
                        labels: data.map(x => `${x.month}/${x.year}`),
                        datasets: [{
                            label: 'Fines (Rs.)',
                            data: data.map(x => x.totalFines),
                            borderColor: '#f85149',
                            backgroundColor: 'rgba(248,81,73,0.1)',
                            fill: true, tension: 0.4
                        }]
                    },
                    options: { ...chartDefaults, responsive: true }
                });
            }).catch(() => {
                document.getElementById('statFines').textContent = '0';
            });

        // Department Stats
        fetch('/Analytics/DepartmentStats')
            .then(r => r.json())
            .then(data => {
                document.getElementById('statDepts').textContent = data.length;
                new Chart(document.getElementById('deptChart'), {
                    type: 'doughnut',
                    data: {
                        labels: data.map(x => x.department || 'Unknown'),
                        datasets: [{
                            data: data.map(x => x.totalBorrows),
                            backgroundColor: ['#1f6feb','#238636','#f85149','#d29922','#8957e5','#0891b2']
                        }]
                    },
                    options: { responsive: true, plugins: { legend: { labels: { color: '#8b949e' } } } }
                });
            }).catch(() => {
                document.getElementById('statDepts').textContent = '0';
            });

        // Activity Logs
        fetch('/Analytics/ActivityLogs')
            .then(r => r.json())
            .then(data => {
                let tbody = document.getElementById('logsTableBody');
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color:#8b949e">No logs yet</td></tr>';
                } else {
                    tbody.innerHTML = data.map((x, i) => `
                        <tr>
                            <td>${i+1}</td>
                            <td><span style="color:#58a6ff;font-weight:600">${x.action}</span></td>
                            <td>${x.description || ''}</td>
                            <td style="color:#8b949e">${x.ipAddress || ''}</td>
                            <td style="color:#8b949e">${new Date(x.loggedAt).toLocaleString()}</td>
                            <td>${x.isSuccess ? '<span style="color:#238636">✓ Success</span>' : '<span style="color:#f85149">✗ Failed</span>'}</td>
                        </tr>`).join('');
                }
            }).catch(() => {});
    </script>
</body>
</html>  